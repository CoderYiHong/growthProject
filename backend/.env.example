# ============================================================
# 环境变量参考（生产环境部署时设置）
# 本项目不会自动读取 .env 文件，请通过以下方式注入：
#
#   PowerShell: $env:VAR_NAME="value"; mvn spring-boot:run
#   Linux/macOS: VAR_NAME=value mvn spring-boot:run
#   IDE: Run Configuration → Environment Variables
#   Docker:  docker run -e VAR_NAME=value ...
# ============================================================

# 管理员账号
ADMIN_USERNAME=admin

# BCrypt Hash（必填，缺失则启动失败）
# 生成方式：Java 中调用 new BCryptPasswordEncoder().encode("your-password")
ADMIN_PASSWORD_HASH=

# Token 签名密钥（必填，至少 16 字符，缺失则启动失败）
ADMIN_TOKEN_SECRET=

# CORS 允许的前端地址（逗号分隔）
CORS_ORIGINS=https://your-frontend-domain.com

# CSDN 文章同步（可选，不设置时使用项目内默认账号）
CSDN_RSS_URL=https://blog.csdn.net/Yihong1833100198/rss/list
CSDN_AUTHOR_NAME=YiHong

# GitHub 项目同步（Token 可选；配置后公共 API 限额由 60/小时提升）
GITHUB_USERNAME=CoderYiHong
GITHUB_TOKEN=
GITHUB_INCLUDE_FORKS=false

# ============================================================
# 本地开发可激活 dev profile：
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev
# dev profile 自带测试 Hash 和 Secret，无需额外设置环境变量
#
# CI / 生产构建：
#   mvn clean verify
# ============================================================
#
# 数据库迁移（生产）：
#   1. 备份：mysqldump -u <migration_user> -p growth site_setting > backup_$(date +%Y%m%d).sql
#   2. 迁移：mysql -u <migration_user> -p growth < sql/migrate_v2.sql
#   3. 回滚：mysql -u <migration_user> -p growth < sql/rollback_v2.sql
#   迁移账号仅需：SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, ALTER, INDEX on growth.*
# ============================================================
