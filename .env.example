# ============================================================
# YiHong 个人成长作品集 — 环境变量配置
# 复制为 .env 后填入真实值（.env 不会被提交到 Git）
# ============================================================

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=growth123

# ---- 管理后台认证（必填，生产环境需使用强密码和 BCrypt Hash） ----
# BCrypt Hash 生成方式：使用在线工具或 BCryptPasswordEncoder 加密
ADMIN_PASSWORD_HASH=$2a$10$YourBcryptHashHere
# 至少 32 字符随机字符串
ADMIN_TOKEN_SECRET=your-random-secret-at-least-32-characters

# ---- CORS（允许的前端域名，逗号分隔） ----
CORS_ORIGINS=http://localhost

# ---- Gmail SMTP（联系表单邮件通知） ----
GMAIL_USERNAME=your-name@gmail.com
# Google 应用专用密码（16位），非邮箱登录密码
GMAIL_APP_PASSWORD=your-16-digit-app-password
# 可选：通知发送到其他邮箱；不设置时发送到 GMAIL_USERNAME
CONTACT_RECEIVE_EMAIL=

# ---- GitHub 同步（可选，但推荐配置以提升 API 额度） ----
GITHUB_TOKEN=ghp_your-read-only-token
GITHUB_USERNAME=CoderYiHong
GITHUB_INCLUDE_FORKS=false

# ---- CSDN 同步 ----
CSDN_RSS_URL=https://blog.csdn.net/Yihong1833100198/rss/list
CSDN_AUTHOR_NAME=YiHong
